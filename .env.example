# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL="postgresql://user:password@localhost:5432/progresso_io"

# Better Auth ------------------------------------------------------------------
# Secret used to sign sessions/tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the app (used for OAuth callbacks and e-mail links).
BETTER_AUTH_URL="http://localhost:3000"
# Bootstrap admin: the single sign-up with this e-mail gets the admin role.
# Further admins are added in-app later. Everyone else signs up as a coach.
ADMIN_EMAIL="admin@progresso.io"

# Google OAuth (optional) ------------------------------------------------------
# When both are set, "Entrar com Google" is enabled.
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional e-mail) ------------------------------------------------
# When unset, OTP codes are logged to the server console (local dev only).
RESEND_API_KEY=""
EMAIL_FROM="Progresso IO <no-reply@progresso.io>"
# Destination for contact-form messages (never shown to visitors).
CONTACT_EMAIL=""

# Pix (assinatura) -------------------------------------------------------------
# Receives the clinic's subscription payment. Pix settles bank-to-bank off a
# key, so NO gateway and NO CNPJ are needed — a pessoa física key works. When
# PIX_KEY is empty the "Assinar" panel still raises the fatura and notifies
# CONTACT_EMAIL, it just shows no code. Server-only: never NEXT_PUBLIC_*.
# Key may be CPF/CNPJ, phone (+55...), e-mail or a random key.
PIX_KEY=""
# Shown in the payer's bank app. Accents are stripped and long values truncated
# (25 chars for the name, 15 for the city) to satisfy the BR Code spec.
PIX_MERCHANT_NAME="Progresso IO"
PIX_MERCHANT_CITY="SAO PAULO"

# Google Analytics ------------------------------------------------------------
# Measurement id (e.g. G-XXXXXXXXXX). Public and inlined at BUILD time, so it
# must be set when the image is built (Dokploy passes it as a compose build arg).
# When empty, analytics is disabled. GA only loads after the visitor consents.
NEXT_PUBLIC_GA_ID=""

# Exercise images -------------------------------------------------------------
# Public base URL the exercise catalog builds image URLs from (Cloudflare R2
# custom domain). Public and inlined at BUILD time. When empty, the app falls
# back to the free-exercise-db CDN, so images still load in local dev.
NEXT_PUBLIC_EXERCISE_IMAGE_BASE_URL=""
# Cloudflare R2 upload credentials. The deploy migrator (scripts/migrate.mjs)
# uploads the exercise images to the bucket AUTOMATICALLY after seeding, and the
# APP service uses the same vars so coaches/admin can UPLOAD custom exercise
# images at runtime — set these on BOTH the migrator and the app service (the
# compose passes them to both). The images are NOT in the repo; the seed uploader
# streams them from the source CDN (or a local folder if present). Idempotent: it
# skips once a full upload's manifest is present. When any of these is unset the
# seed upload is skipped, the app falls back to the source CDN for the base
# images, and the runtime upload route answers a friendly 503 (exercises still
# save without images).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional key prefix inside the bucket (e.g. "exercises"). Defaults to none, so
# keys are "<code>/0.jpg"; must line up with NEXT_PUBLIC_EXERCISE_IMAGE_BASE_URL.
R2_PREFIX=""

# Sentry (error tracking + performance + session replay) ----------------------
# When unset, the SDK is a no-op — nothing is captured (mirrors GA/Resend/R2).
# The DSN is a publishable key (it ships in the browser bundle by design); set
# the SAME value on both vars. Use an EU (Frankfurt, *.ingest.de.sentry.io) DSN
# for the LGPD-friendly data region. NEXT_PUBLIC_SENTRY_DSN is inlined at BUILD
# time, so it must be set when the image is built (Dokploy build arg).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Source-map upload at build time → readable stack traces. Optional: a build
# WITHOUT the auth token still succeeds, it just skips the upload. Create the
# token at Sentry → Settings → Auth Tokens (scopes: project:read, project:releases).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# AI Program Generator (roadmap item 1) ---------------------------------------
# The generator talks to OpenRouter: one OpenAI-compatible endpoint fronting
# nearly every vendor. Unset LLM_API_KEY → the feature is OFF: the "Gerar com
# IA" button answers a friendly "IA não configurada" and never spends a credit.
#
# WHICH MODEL IS NOT SET HERE. It lives in the database and is edited at
# /admin/ai → Modelos, because it is the one setting that actually gets changed
# — a new model takes effect on the next generation, with no deploy and no
# restart. Everything else the provider needs (temperature, output ceiling,
# timeout) is a constant in src/lib/llm-provider.ts.
LLM_API_KEY=""

# Optional. Defaults to OpenRouter; override to call a vendor directly or to
# point at a local mock. This is the part BEFORE /chat/completions — the version
# segment belongs in it, and trailing slashes are stripped for you.
#   ✓ https://openrouter.ai/api/v1                     (default)
#   ✓ https://api.openai.com/v1
#   ✗ https://openrouter.ai/api/v1/chat/completions    (doubles the path)
LLM_BASE_URL=""
